<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksInteropDir>
    <UseInstalledInterop Condition="'$(UseInstalledInterop)' == '' and Exists('$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll')">true</UseInstalledInterop>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseInstalledInterop)' == 'true'">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- CI runners lack SOLIDWORKS. These community-published interop packages
       are pinned; local builds prefer the installed vendor redistributables. -->
  <ItemGroup Condition="'$(UseInstalledInterop)' != 'true'">
    <PackageReference Include="SolidWorks.Interop.sldworks" Version="32.1.0" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="32.1.0" />
  </ItemGroup>
</Project>
